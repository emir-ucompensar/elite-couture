<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Elite.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/color_primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeErrorColor">@color/color_error</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:fontFamily">@font/elite_sans</item>
        <item name="hintTextAppearance">@style/Widget.Elite.TextInputLayout.Hint</item>
        <item name="errorTextColor">@color/color_error</item>
        <item name="helperTextTextColor">@color/text_hint</item>
        <item name="errorIconDrawable">@null</item>
    </style>

    <style name="Widget.Elite.TextInputLayout.Hint" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/elite_sans</item>
    </style>

    <style name="Widget.Elite.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">@font/elite_sans</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.Elite.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textSize">16sp</item>
        <item name="rippleColor">@color/button_primary_pressed</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">@font/elite_sans</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Elite.SocialOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="strokeColor">@color/button_social_google_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">@font/elite_sans</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Widget.Elite.SocialFilledButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">@font/elite_sans</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="TextAppearance.Elite.NavigationItem" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/elite_sans</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Dialog Styles -->
    <style name="EliteCoutureDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/EliteCoutureDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/EliteCoutureDialogMessage</item>
        <item name="buttonBarPositiveButtonStyle">@style/EliteCoutureDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/EliteCoutureDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/EliteCoutureDialogButton</item>
        <item name="shapeAppearanceOverlay">@style/EliteCoutureDialogShape</item>
        <item name="android:background">@color/surface_light</item>
    </style>

    <style name="EliteCoutureDialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:fontFamily">@font/elite_sans_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="EliteCoutureDialogMessage" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:fontFamily">@font/elite_sans</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="EliteCoutureDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/elite_sans_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="rippleColor">@color/button_primary_pressed</item>
    </style>

    <style name="EliteCoutureDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
