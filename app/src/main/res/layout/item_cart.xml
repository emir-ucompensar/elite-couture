<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Imagen del producto -->
        <ImageView
            android:id="@+id/image_product"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/desc_product_image"
            tools:src="@drawable/product_placeholder" />

        <!-- Información del producto -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Nombre del producto -->
            <TextView
                android:id="@+id/text_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/elite_sans_semibold"
                android:textColor="@color/text_primary_dark"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Camisa de Seda Elegante" />

            <!-- Descripción del producto -->
            <TextView
                android:id="@+id/text_product_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/elite_sans"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Descripción breve del producto" />

            <!-- Precio unitario -->
            <TextView
                android:id="@+id/text_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/elite_sans_semibold"
                android:textColor="@color/color_primary"
                android:textSize="14sp"
                tools:text="$99.99" />

            <!-- Controles de cantidad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Botón Decrementar -->
                <ImageButton
                    android:id="@+id/button_decrease"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/minus_box"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_decrease_quantity"
                    app:tint="@color/color_primary" />

                <!-- Cantidad -->
                <TextView
                    android:id="@+id/text_quantity"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:fontFamily="@font/elite_sans_semibold"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="16sp"
                    tools:text="2" />

                <!-- Botón Incrementar -->
                <ImageButton
                    android:id="@+id/button_increase"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/plus_box"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/desc_increase_quantity"
                    app:tint="@color/color_primary" />

                <!-- Espacio flexible -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Stock disponible -->
                <TextView
                    android:id="@+id/text_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/elite_sans"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    tools:text="Stock: 10" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
