<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/divider_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nombre de la tienda -->
        <TextView
            android:id="@+id/store_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/elite_sans_semibold"
            android:text="Elite Couture - Centro Andino"
            android:textColor="@color/color_primary"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Dirección -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/store_marker"
                app:tint="@color/text_secondary_dark" />

            <TextView
                android:id="@+id/store_item_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/elite_sans"
                android:text="Carrera 11 # 82-71, Local 205"
                android:textColor="@color/text_secondary_dark"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Teléfono -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/phone"
                app:tint="@color/text_secondary_dark" />

            <TextView
                android:id="@+id/store_item_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/elite_sans"
                android:text="+57 (1) 555-0101"
                android:textColor="@color/text_secondary_dark"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Horario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/clock_time_four"
                app:tint="@color/text_secondary_dark" />

            <TextView
                android:id="@+id/store_item_hours"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/elite_sans"
                android:text="Lun-Sáb: 10:00 AM - 8:00 PM"
                android:textColor="@color/text_secondary_dark"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Botón Cómo llegar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/store_item_directions_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/brand_color"
            android:text="@string/store_info_how_to_get"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:fontFamily="@font/elite_sans_semibold"
            app:cornerRadius="8dp"
            app:icon="@drawable/store_marker"
            app:iconGravity="start"
            app:iconTint="@android:color/white" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
