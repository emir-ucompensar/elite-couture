<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido principal -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Top App Bar con logo centrado y menú -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_store"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_light"
            android:elevation="4dp"
            app:title="ELITE COUTURE"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            app:titleTextColor="@color/color_primary"
            app:navigationIcon="@drawable/menu"
            app:navigationIconTint="@color/color_primary" />

        <!-- Contenido principal -->
        <FrameLayout
            android:id="@+id/store_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Indicador de filtro activo -->
                <TextView
                    android:id="@+id/text_active_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/surface_light"
                    android:elevation="2dp"
                    android:fontFamily="@font/elite_sans"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Mujer - Vestidos"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- RecyclerView vertical para lista de productos -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_products"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:paddingEnd="16dp"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_product" />

            </LinearLayout>

        </FrameLayout>

        <!-- Barra de navegación inferior -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/surface_light"
            app:itemTextColor="@color/bottom_nav_icon_color"
            app:itemIconTint="@color/bottom_nav_icon_color"
            app:itemBackground="@drawable/bottom_nav_item_background"
            app:menu="@menu/menu_navigation_bottom" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Menú lateral -->
    <include
        layout="@layout/drawer_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
