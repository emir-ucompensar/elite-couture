<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/color_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Logotipo principal -->
    <ImageView
        android:id="@+id/splash_logo"
        android:src="@drawable/ic_brand_logo_color"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="40dp" />

    <!-- Nombre de la app -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAllCaps="true"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_light"
        android:layout_marginBottom="50dp"
        android:fontFamily="@font/elite_sans" />

    <!-- Barra de carga -->
    <ProgressBar
        android:id="@+id/splash_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="200dp"
        android:layout_height="6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/text_primary_light"
        android:backgroundTint="@color/color_primary_light"
        android:layout_gravity="center" />

    <!-- Texto de estado -->
    <TextView
        android:id="@+id/splash_loading_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/splash_loading_text"
    android:textSize="16sp"
    android:textColor="@color/text_primary_light"
    android:layout_marginTop="16dp"
    android:fontFamily="@font/elite_sans" />

</LinearLayout>
