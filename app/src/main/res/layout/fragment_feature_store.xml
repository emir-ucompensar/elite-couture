<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido principal -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Top App Bar con logo centrado y menú -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_store"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_light"
            android:elevation="4dp"
            app:title="ELITE COUTURE"
            app:titleCentered="true"
            app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            app:titleTextColor="@color/color_primary"
            app:navigationIcon="@drawable/menu"
            app:navigationIconTint="@color/color_primary" />

        <!-- Contenido principal -->
        <FrameLayout
            android:id="@+id/store_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- SwipeRefreshLayout para pull-to-refresh -->
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!-- Indicador de filtro activo -->
                    <TextView
                        android:id="@+id/text_active_filter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/surface_light"
                        android:elevation="2dp"
                        android:fontFamily="@font/elite_sans"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Mujer - Vestidos"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- RecyclerView vertical para lista de productos -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_products"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="16dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none"
                        tools:listitem="@layout/item_product" />

                    <!-- Estado vacío para categorías sin productos -->
                    <LinearLayout
                        android:id="@+id/empty_category_state"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginBottom="24dp"
                        android:alpha="0.3"
                        android:src="@drawable/hanger"
                        app:tint="@color/color_primary" />

                    <TextView
                        android:id="@+id/text_empty_category_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/elite_sans_semibold"
                        android:text="@string/empty_category_title"
                        android:textAlignment="center"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/text_empty_category_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:fontFamily="@font/elite_sans"
                        android:lineSpacingExtra="4dp"
                        android:textAlignment="center"
                        android:textColor="@color/text_secondary_dark"
                        android:textSize="16sp"
                        tools:text="El stock de Hombre - Camisas se ha agotado rápidamente.\n¡Explora nuestros otros productos y no te pierdas de nuestras ofertas!" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_explore_products"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/elite_sans_semibold"
                        android:letterSpacing="0.05"
                        android:text="@string/empty_category_button"
                        android:textSize="14sp"
                        app:cornerRadius="8dp" />

                </LinearLayout>

            </LinearLayout>

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        </FrameLayout>

        <!-- Barra de navegación inferior -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/surface_light"
            app:itemTextColor="@color/bottom_nav_icon_color"
            app:itemIconTint="@color/bottom_nav_icon_color"
            app:itemBackground="@drawable/bottom_nav_item_background"
            app:menu="@menu/menu_navigation_bottom" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Menú lateral -->
    <include
        layout="@layout/drawer_menu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
